{
  "embedder": {
    "client_class": "AzureAIClient",
    "batch_size": 10,
    "model_kwargs": {
      "encoding_format": "float"
    }
  },
  "retriever": {
    "top_k": 12
  },
  "text_splitter": {
    "split_by": "passage",
    "chunk_size": 15,
    "chunk_overlap": 3,
    "separators": {
      "passage": "\n\n"
    }
  }
}
