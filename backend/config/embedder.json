{
  "embedder": {
    "client_class": "AzureAIClient",
    "batch_size": 10,
    "model_kwargs": {
      "encoding_format": "float"
    }
  },
  "retriever": {
    "top_k": 12
  },
  "text_splitter": {
    "split_by": "token",
    "chunk_size": 2000,
    "chunk_overlap": 200
  },
  "llm_enhance": {
    "enabled": false,
    "max_output_enhanced": 4096,
    "max_output_key_objects": 512,
    "max_context_window": 128000
  }
}
