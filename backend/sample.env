# DeepWiki Local Development Environment Variables
# Copy this file to .env and fill in your values
#
# Azure OpenAI API Key (for local dev without MSI)
#   Azure Portal → Azure OpenAI → your resource → Keys and Endpoint → Key 1
AZURE_OPENAI_API_KEY=your-api-key-here

# Azure DevOps Personal Access Token (for private repo access)
#   Azure DevOps → User Settings → Personal Access Tokens → New Token (Code: Read)
#   Leave blank to use your Azure CLI identity (az login) instead
REPO_ACCESS_TOKEN=
