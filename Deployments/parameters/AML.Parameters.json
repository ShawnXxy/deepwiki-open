{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "location": {
            "value": "{{location}}"
        },
        "tenantId": {
            "value": "{{tenant_id}}"
        },
        "machineLearningWorkspaceName": {
            "value": "{{machine_learning_workspace_name}}"
        },
        "machineLearningWorkspaceSubComponentsNamePrefix": {
            "value": "{{machine_learning_workspace_sub_components_name_prefix}}"
        },
        "existingStorageAccountName": {
            "value": "{{storage_account_name}}"
        },
        "existingKeyVaultName": {
            "value": "{{key_vault_name}}"
        },
        "existingApplicationInsightsName": {
            "value": "{{application_insights_name}}"
        },
        "existingLogAnalyticsWorkspaceName": {
            "value": "{{log_analytics_workspace_name}}"
        },
        "deepWikiIdentityName": {
            "value": "{{dri_copilot_identity_name}}"
        },
        "openAiResourceName": {
            "value": "{{open_ai_resource_name}}"
        },
        "deploymentIdentityPrincipalId": {
            "value": "{{deployment_identity_principal_id}}"
        },
        "deploymentIdentityPrincipalType": {
            "value": "User"
        },
        "isOpenAiResourceManagedByDeepWiki": {
            "value": {{is_creating_open_ai_endpoint}}
        },
        "isCreatingVnetForAzureML": {
            "value": {{is_creating_vnet_for_azure_ml}}
        },
        "isEnablingDiskEncryptionForAzureML": {
            "value": {{is_enabling_disk_encryption_for_azure_ml}}
        },
        "resourceTags": {
            "value": {{resource_tags}}
        }
    }
}
