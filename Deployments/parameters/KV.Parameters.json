{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "location": {
            "value": "{{location}}"
        },
        "keyVaultName": {
            "value": "{{key_vault_name}}"
        },
        "enableRbacAuthorization": {
            "value": true
        },
        "enableSoftDelete": {
            "value": true
        },
        "softDeleteRetentionDays": {
            "value": 90
        },
        "enablePurgeProtection": {
            "value": true
        },
        "skuName": {
            "value": "standard"
        },
        "resourceTags": {
            "value": {{resource_tags}}
        }
    }
}
