{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "location": {
            "defaultValue": "eastus",
            "type": "string",
            "metadata": {
                "description": "Location of the Azure Open AI endpoint."
            }
        },
        "openAiResourceName": {
            "type": "string",
            "metadata": {
                "description": "Specifies the name of Azure Open AI endpoint."
            }
        },
        "isCreatingOpenAiEndpoint": {
            "defaultValue": true,
            "type": "bool",
            "metadata": {
                "description": "Specifies whether to create the OpenAI endpoint. If not, we assume the endpoint already exists."
            }
        },
        "openAiChatModelDeploymentName": {
            "defaultValue": "gpt-5.6-luna",
            "type": "string",
            "metadata": {
                "description": "Specifies the chat model deployment name."
            }
        },
        "openAiChatModelModelName": {
            "defaultValue": "gpt-5.6-luna",
            "allowedValues": [
                "gpt-5.6-luna",
                "gpt-5.6-terra",
                "gpt-5.6-sol"
            ],
            "type": "string",
            "metadata": {
                "description": "Specifies the chat model."
            }
        },
        "openAiChatModelTokensPerMinute": {
            "defaultValue": 200,
            "type": "int",
            "metadata": {
                "description": "Token capacity for the chat model."
            }
        },
        "openAiChatModelVersion": {
            "defaultValue": "2026-07-09",
            "type": "string",
            "metadata": {
                "description": "Specifies the chat model version."
            }
        },
        "openAiChatModelSkuName": {
            "defaultValue": "GlobalStandard",
            "allowedValues": [
                "Standard",
                "GlobalStandard",
                "DataZoneStandard"
            ],
            "type": "string",
            "metadata": {
                "description": "Specifies the chat model SKU."
            }
        },
        "openAiReasoningModelDeploymentName": {
            "defaultValue": "gpt-5.6-terra",
            "type": "string",
            "metadata": {
                "description": "Specifies the name of the reasoning model deployment."
            }
        },
        "openAiReasoningModelModelName": {
            "defaultValue": "gpt-5.6-terra",
            "allowedValues": [
                "gpt-5.6-luna",
                "gpt-5.6-terra",
                "gpt-5.6-sol"
            ],
            "type": "string",
            "metadata": {
                "description": "Specifies the name of the reasoning model."
            }
        },
        "openAiReasoningModelTokensPerMinute": {
            "defaultValue": 200,
            "type": "int",
            "metadata": {
                "description": "Token per minute for reasoning model."
            }
        },
        "openAiReasoningModelVersion": {
            "defaultValue": "2026-07-09",
            "type": "string",
            "metadata": {
                "description": "Specifies the version of the reasoning model."
            }
        },
        "openAiReasoningModelSkuName": {
            "defaultValue": "GlobalStandard",
            "allowedValues": [
                "Standard",
                "GlobalStandard",
                "DataZoneStandard"
            ],
            "type": "string",
            "metadata": {
                "description": "Specifies the SKU name of the reasoning model."
            }
        },
        "openAiPremiumReasoningModelDeploymentName": {
            "defaultValue": "gpt-5.6-sol",
            "type": "string",
            "metadata": {
                "description": "Specifies the premium reasoning deployment name."
            }
        },
        "openAiPremiumReasoningModelModelName": {
            "defaultValue": "gpt-5.6-sol",
            "allowedValues": [
                "gpt-5.6-luna",
                "gpt-5.6-terra",
                "gpt-5.6-sol"
            ],
            "type": "string",
            "metadata": {
                "description": "Specifies the premium reasoning model."
            }
        },
        "openAiPremiumReasoningModelTokensPerMinute": {
            "defaultValue": 200,
            "type": "int",
            "metadata": {
                "description": "Token capacity for the premium reasoning model."
            }
        },
        "openAiPremiumReasoningModelVersion": {
            "defaultValue": "2026-07-09",
            "type": "string",
            "metadata": {
                "description": "Specifies the premium reasoning model version."
            }
        },
        "openAiPremiumReasoningModelSkuName": {
            "defaultValue": "GlobalStandard",
            "allowedValues": [
                "Standard",
                "GlobalStandard",
                "DataZoneStandard"
            ],
            "type": "string",
            "metadata": {
                "description": "Specifies the premium reasoning model SKU."
            }
        },
        "openAiEmbeddingDeploymentName": {
            "defaultValue": "text-embedding-3-large",
            "type": "string",
            "metadata": {
                "description": "Specifies the name of the embedding deployment."
            }
        },
        "openAiEmbeddingModelName": {
            "defaultValue": "text-embedding-3-large",
            "allowedValues": [
                "text-embedding-ada-002",
                "text-embedding-3-large",
                "text-embedding-3-small"
            ],
            "type": "string",
            "metadata": {
                "description": "Specifies the name of the embedding model."
            }
        },
        "openAiEmbeddingTokensPerMinute": {
            "defaultValue": 50,
            "type": "int",
            "metadata": {
                "description": "Token per minute for embedding model."
            }
        },
        "openAiEmbeddingVersion": {
            "defaultValue": "1",
            "type": "string",
            "metadata": {
                "description": "Specifies the version of the embedding model."
            }
        },
        "openAiEmbeddingSkuName": {
            "defaultValue": "Standard",
            "allowedValues": [
                "Standard",
                "GlobalStandard",
                "DataZoneStandard"
            ],
            "type": "string",
            "metadata": {
                "description": "Specifies the SKU name of the embedding model."
            }
        },
        "privateNetwork": {
            "defaultValue": false,
            "type": "bool",
            "metadata": {
                "description": "When true, the OpenAI account is created with public network access disabled and outbound DLP (restrictOutboundNetworkAccess) enabled - required by the CloudGov_DLP_AzOpenAI policy when disabling public access. When false, public access stays enabled (original behavior)."
            }
        },
        "resourceTags": {
            "defaultValue": {},
            "type": "object",
            "metadata": {
                "description": "Tags to assign to given resources"
            }
        }
    },
    "variables": {
        "openAiResourceId": "[resourceId('Microsoft.CognitiveServices/accounts', parameters('openAiResourceName'))]",
        "openAiChatModelDeploymentId": "[resourceId('Microsoft.CognitiveServices/accounts/deployments', parameters('openAiResourceName'), parameters('openAiChatModelDeploymentName'))]",
        "openAiReasoningModelDeploymentId": "[resourceId('Microsoft.CognitiveServices/accounts/deployments', parameters('openAiResourceName'), parameters('openAiReasoningModelDeploymentName'))]",
        "openAiPremiumReasoningModelDeploymentId": "[resourceId('Microsoft.CognitiveServices/accounts/deployments', parameters('openAiResourceName'), parameters('openAiPremiumReasoningModelDeploymentName'))]"
    },
    "resources": [
        {
            "condition": "[parameters('isCreatingOpenAiEndpoint')]",
            "type": "Microsoft.CognitiveServices/accounts",
            "apiVersion": "2023-10-01-preview",
            "name": "[parameters('openAiResourceName')]",
            "location": "[parameters('location')]",
            "tags": "[parameters('resourceTags')]",
            "sku": {
                "name": "S0"
            },
            "kind": "OpenAI",
            "properties": {
                "customSubDomainName": "[parameters('openAiResourceName')]",
                "networkAcls": {
                    "defaultAction": "[if(parameters('privateNetwork'), 'Deny', 'Allow')]",
                    "virtualNetworkRules": [],
                    "ipRules": []
                },
                "publicNetworkAccess": "[if(parameters('privateNetwork'), 'Disabled', 'Enabled')]",
                "restrictOutboundNetworkAccess": "[parameters('privateNetwork')]",
                "allowedFqdnList": [],
                "disableLocalAuth": true
            }
        },
        {
            "condition": "[parameters('isCreatingOpenAiEndpoint')]",
            "type": "Microsoft.CognitiveServices/accounts/deployments",
            "apiVersion": "2025-04-01-preview",
            "name": "[concat(parameters('openAiResourceName'), '/', parameters('openAiChatModelDeploymentName'))]",
            "dependsOn": [
                "[variables('openAiResourceId')]"
            ],
            "sku": {
                "name": "[parameters('openAiChatModelSkuName')]",
                "capacity": "[parameters('openAiChatModelTokensPerMinute')]"
            },
            "properties": {
                "model": {
                    "format": "OpenAI",
                    "name": "[parameters('openAiChatModelModelName')]",
                    "version": "[parameters('openAiChatModelVersion')]"
                },
                "versionUpgradeOption": "OnceNewDefaultVersionAvailable",
                "currentCapacity": "[parameters('openAiChatModelTokensPerMinute')]",
                "raiPolicyName": "Microsoft.Default"
            }
        },
        {
            "condition": "[parameters('isCreatingOpenAiEndpoint')]",
            "type": "Microsoft.CognitiveServices/accounts/deployments",
            "apiVersion": "2025-04-01-preview",
            "name": "[concat(parameters('openAiResourceName'), '/', parameters('openAiReasoningModelDeploymentName'))]",
            "dependsOn": [
                "[variables('openAiResourceId')]"
            ],
            "sku": {
                "name": "[parameters('openAiReasoningModelSkuName')]",
                "capacity": "[parameters('openAiReasoningModelTokensPerMinute')]"
            },
            "properties": {
                "model": {
                    "format": "OpenAI",
                    "name": "[parameters('openAiReasoningModelModelName')]",
                    "version": "[parameters('openAiReasoningModelVersion')]"
                },
                "versionUpgradeOption": "OnceNewDefaultVersionAvailable",
                "currentCapacity": "[parameters('openAiReasoningModelTokensPerMinute')]",
                "raiPolicyName": "Microsoft.Default"
            }
        },
        {
            "condition": "[parameters('isCreatingOpenAiEndpoint')]",
            "type": "Microsoft.CognitiveServices/accounts/deployments",
            "apiVersion": "2025-04-01-preview",
            "name": "[concat(parameters('openAiResourceName'), '/', parameters('openAiPremiumReasoningModelDeploymentName'))]",
            "dependsOn": [
                "[variables('openAiResourceId')]"
            ],
            "sku": {
                "name": "[parameters('openAiPremiumReasoningModelSkuName')]",
                "capacity": "[parameters('openAiPremiumReasoningModelTokensPerMinute')]"
            },
            "properties": {
                "model": {
                    "format": "OpenAI",
                    "name": "[parameters('openAiPremiumReasoningModelModelName')]",
                    "version": "[parameters('openAiPremiumReasoningModelVersion')]"
                },
                "versionUpgradeOption": "OnceNewDefaultVersionAvailable",
                "currentCapacity": "[parameters('openAiPremiumReasoningModelTokensPerMinute')]",
                "raiPolicyName": "Microsoft.Default"
            }
        },
        {
            "condition": "[parameters('isCreatingOpenAiEndpoint')]",
            "type": "Microsoft.CognitiveServices/accounts/deployments",
            "apiVersion": "2023-10-01-preview",
            "name": "[concat(parameters('openAiResourceName'), '/', parameters('openAiEmbeddingDeploymentName'))]",
            "dependsOn": [
                "[variables('openAiResourceId')]",
                "[variables('openAiChatModelDeploymentId')]",
                "[variables('openAiReasoningModelDeploymentId')]",
                "[variables('openAiPremiumReasoningModelDeploymentId')]"
            ],
            "sku": {
                "name": "[parameters('openAiEmbeddingSkuName')]",
                "capacity": "[parameters('openAiEmbeddingTokensPerMinute')]"
            },
            "properties": {
                "model": {
                    "format": "OpenAI",
                    "name": "[parameters('openAiEmbeddingModelName')]",
                    "version": "[parameters('openAiEmbeddingVersion')]"
                },
                "versionUpgradeOption": "OnceNewDefaultVersionAvailable",
                "currentCapacity": "[parameters('openAiEmbeddingTokensPerMinute')]",
                "raiPolicyName": "Microsoft.Default"
            }
        }
    ],
    "outputs": {}
}
