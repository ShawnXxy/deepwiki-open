{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "location": {
            "defaultValue": "[resourceGroup().location]",
            "type": "string",
            "metadata": {
                "description": "Location for the storage account."
            }
        },
        "storageAccountName": {
            "type": "string",
            "maxLength": 24,
            "metadata": {
                "description": "Name of the Storage Account. Must be globally unique, lowercase, 3-24 characters."
            }
        },
        "storageSkuName": {
            "defaultValue": "Standard_LRS",
            "allowedValues": [
                "Standard_LRS",
                "Standard_GRS",
                "Standard_RAGRS",
                "Standard_ZRS",
                "Premium_LRS"
            ],
            "type": "string",
            "metadata": {
                "description": "SKU name for the storage account."
            }
        },
        "enableBlobSoftDelete": {
            "defaultValue": true,
            "type": "bool",
            "metadata": {
                "description": "Enable soft delete for blobs."
            }
        },
        "blobSoftDeleteRetentionDays": {
            "defaultValue": 28,
            "type": "int",
            "metadata": {
                "description": "Number of days to retain soft-deleted blobs."
            }
        },
        "enableContainerSoftDelete": {
            "defaultValue": true,
            "type": "bool",
            "metadata": {
                "description": "Enable soft delete for containers."
            }
        },
        "containerSoftDeleteRetentionDays": {
            "defaultValue": 28,
            "type": "int",
            "metadata": {
                "description": "Number of days to retain soft-deleted containers."
            }
        },
        "resourceTags": {
            "defaultValue": {},
            "type": "object",
            "metadata": {
                "description": "Tags to assign to the resource."
            }
        },
        "managedIdentityName": {
            "type": "string",
            "defaultValue": "",
            "metadata": {
                "description": "Name of the User-Assigned Managed Identity to assign to the storage account for NSP outbound access."
            }
        }
    },
    "variables": {
        "storageAccountId": "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]",
        "managedIdentityId": "[if(empty(parameters('managedIdentityName')), '', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('managedIdentityName')))]",
        "identityType": "[if(empty(parameters('managedIdentityName')), 'None', 'UserAssigned')]"
    },
    "resources": [
        {
            "type": "Microsoft.Storage/storageAccounts",
            "apiVersion": "2023-01-01",
            "name": "[parameters('storageAccountName')]",
            "location": "[parameters('location')]",
            "tags": "[parameters('resourceTags')]",
            "identity": "[if(equals(variables('identityType'), 'None'), null(), createObject('type', variables('identityType'), 'userAssignedIdentities', createObject(variables('managedIdentityId'), createObject())))]",
            "sku": {
                "name": "[parameters('storageSkuName')]",
                "tier": "Standard"
            },
            "kind": "StorageV2",
            "properties": {
                "defaultToOAuthAuthentication": true,
                "allowBlobPublicAccess": false,
                "supportsHttpsTrafficOnly": true,
                "allowSharedKeyAccess": false,
                "minimumTlsVersion": "TLS1_2",
                "accessTier": "Hot",
                "encryption": {
                    "services": {
                        "blob": {
                            "enabled": true
                        },
                        "file": {
                            "enabled": true
                        }
                    },
                    "keySource": "Microsoft.Storage"
                },
                "publicNetworkAccess": "Disabled",
                "networkAcls": {
                    "bypass": "AzureServices",
                    "defaultAction": "Deny",
                    "virtualNetworkRules": [],
                    "ipRules": []
                }
            }
        },
        {
            "type": "Microsoft.Storage/storageAccounts/blobServices",
            "apiVersion": "2023-01-01",
            "name": "[concat(parameters('storageAccountName'), '/default')]",
            "dependsOn": [
                "[variables('storageAccountId')]"
            ],
            "properties": {
                "containerDeleteRetentionPolicy": {
                    "enabled": "[parameters('enableContainerSoftDelete')]",
                    "days": "[parameters('containerSoftDeleteRetentionDays')]"
                },
                "deleteRetentionPolicy": {
                    "allowPermanentDelete": false,
                    "enabled": "[parameters('enableBlobSoftDelete')]",
                    "days": "[parameters('blobSoftDeleteRetentionDays')]"
                }
            }
        },
        {
            "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
            "apiVersion": "2023-01-01",
            "name": "[concat(parameters('storageAccountName'), '/default/deepwiki-cache')]",
            "dependsOn": [
                "[resourceId('Microsoft.Storage/storageAccounts/blobServices', parameters('storageAccountName'), 'default')]",
                "[variables('storageAccountId')]"
            ],
            "properties": {
                "publicAccess": "None"
            }
        }
    ],
    "outputs": {
        "storageAccountId": {
            "type": "string",
            "value": "[variables('storageAccountId')]"
        },
        "storageAccountName": {
            "type": "string",
            "value": "[parameters('storageAccountName')]"
        },
        "primaryBlobEndpoint": {
            "type": "string",
            "value": "[reference(variables('storageAccountId'), '2023-01-01').primaryEndpoints.blob]"
        }
    }
}
