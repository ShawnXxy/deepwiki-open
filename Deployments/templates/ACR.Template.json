{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "location": {
            "defaultValue": "[resourceGroup().location]",
            "type": "string",
            "metadata": {
                "description": "Location for the Container Registry."
            }
        },
        "containerRegistryName": {
            "type": "string",
            "metadata": {
                "description": "Name of the Azure Container Registry."
            }
        },
        "containerRegistrySku": {
            "defaultValue": "Basic",
            "type": "string",
            "allowedValues": ["Basic", "Standard", "Premium"],
            "metadata": {
                "description": "SKU for the Container Registry."
            }
        },
        "managedIdentityName": {
            "type": "string",
            "metadata": {
                "description": "Name of the Managed Identity to grant AcrPull role."
            }
        },
        "resourceTags": {
            "defaultValue": {},
            "type": "object",
            "metadata": {
                "description": "Tags to assign to the resources."
            }
        }
    },
    "variables": {
        "acrId": "[resourceId('Microsoft.ContainerRegistry/registries', parameters('containerRegistryName'))]",
        "managedIdentityId": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('managedIdentityName'))]",
        "acrPullRoleId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '7f951dda-4ed3-4680-a7ca-43fe172d538d')]"
    },
    "resources": [
        {
            "type": "Microsoft.ContainerRegistry/registries",
            "apiVersion": "2023-07-01",
            "name": "[parameters('containerRegistryName')]",
            "location": "[parameters('location')]",
            "tags": "[parameters('resourceTags')]",
            "sku": {
                "name": "[parameters('containerRegistrySku')]"
            },
            "properties": {
                "adminUserEnabled": false,
                "publicNetworkAccess": "Enabled"
            }
        },
        {
            "type": "Microsoft.Authorization/roleAssignments",
            "apiVersion": "2022-04-01",
            "name": "[guid(variables('acrId'), variables('managedIdentityId'), variables('acrPullRoleId'))]",
            "scope": "[variables('acrId')]",
            "dependsOn": [
                "[variables('acrId')]"
            ],
            "properties": {
                "roleDefinitionId": "[variables('acrPullRoleId')]",
                "principalId": "[reference(variables('managedIdentityId'), '2023-07-31-preview').principalId]",
                "principalType": "ServicePrincipal"
            }
        }
    ],
    "outputs": {
        "containerRegistryId": {
            "type": "string",
            "value": "[variables('acrId')]"
        },
        "containerRegistryLoginServer": {
            "type": "string",
            "value": "[reference(variables('acrId'), '2023-07-01').loginServer]"
        },
        "containerRegistryName": {
            "type": "string",
            "value": "[parameters('containerRegistryName')]"
        }
    }
}
