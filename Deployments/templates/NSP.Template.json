{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "location": {
            "defaultValue": "[resourceGroup().location]",
            "type": "string",
            "metadata": {
                "description": "Location for the NSP resources."
            }
        },
        "nspName": {
            "type": "string",
            "metadata": {
                "description": "Name of the Network Security Perimeter."
            }
        },
        "nspProfileName": {
            "type": "string",
            "metadata": {
                "description": "Name of the NSP profile."
            }
        },
        "resourceTags": {
            "defaultValue": {},
            "type": "object",
            "metadata": {
                "description": "Tags to assign to the resources."
            }
        }
    },
    "variables": {
        "nspId": "[resourceId('Microsoft.Network/networkSecurityPerimeters', parameters('nspName'))]",
        "nspProfileId": "[resourceId('Microsoft.Network/networkSecurityPerimeters/profiles', parameters('nspName'), parameters('nspProfileName'))]",
        "shouldCreateNsp": "[and(not(empty(parameters('nspName'))), not(startsWith(parameters('nspName'), '__')))]"
    },
    "resources": [
        {
            "condition": "[variables('shouldCreateNsp')]",
            "type": "Microsoft.Network/networkSecurityPerimeters",
            "apiVersion": "2024-07-01",
            "name": "[parameters('nspName')]",
            "location": "[parameters('location')]",
            "tags": "[parameters('resourceTags')]"
        },
        {
            "condition": "[variables('shouldCreateNsp')]",
            "type": "Microsoft.Network/networkSecurityPerimeters/profiles",
            "apiVersion": "2024-07-01",
            "name": "[concat(parameters('nspName'), '/', parameters('nspProfileName'))]",
            "location": "[parameters('location')]",
            "tags": "[parameters('resourceTags')]",
            "dependsOn": [
                "[variables('nspId')]"
            ]
        },
        {
            "condition": "[variables('shouldCreateNsp')]",
            "type": "Microsoft.Network/networkSecurityPerimeters/profiles/accessRules",
            "apiVersion": "2024-07-01",
            "name": "[concat(parameters('nspName'), '/', parameters('nspProfileName'), '/Inbound-Allow-Subscription')]",
            "dependsOn": [
                "[variables('nspProfileId')]",
                "[variables('nspId')]"
            ],
            "properties": {
                "direction": "Inbound",
                "subscriptions": [
                    {
                        "id": "[subscription().id]"
                    }
                ]
            }
        },
        {
            "condition": "[variables('shouldCreateNsp')]",
            "type": "Microsoft.Network/networkSecurityPerimeters/profiles/accessRules",
            "apiVersion": "2024-07-01",
            "name": "[concat(parameters('nspName'), '/', parameters('nspProfileName'), '/Inbound-Allow-ServiceTags')]",
            "dependsOn": [
                "[variables('nspProfileId')]",
                "[variables('nspId')]"
            ],
            "properties": {
                "direction": "Inbound",
                "serviceTags": ["MicrosoftPublicIPSpace"]
            }
        },
        {
            "condition": "[variables('shouldCreateNsp')]",
            "type": "Microsoft.Network/networkSecurityPerimeters/profiles/accessRules",
            "apiVersion": "2024-07-01",
            "name": "[concat(parameters('nspName'), '/', parameters('nspProfileName'), '/Outbound-Allow-All')]",
            "dependsOn": [
                "[variables('nspProfileId')]",
                "[variables('nspId')]"
            ],
            "properties": {
                "direction": "Outbound",
                "fullyQualifiedDomainNames": [
                    "*"
                ]
            }
        }
    ],
    "outputs": {
        "nspId": {
            "condition": "[variables('shouldCreateNsp')]",
            "type": "string",
            "value": "[variables('nspId')]"
        },
        "nspProfileId": {
            "condition": "[variables('shouldCreateNsp')]",
            "type": "string",
            "value": "[variables('nspProfileId')]"
        }
    }
}