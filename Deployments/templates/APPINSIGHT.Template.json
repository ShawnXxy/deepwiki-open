{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "location": {
            "defaultValue": "[resourceGroup().location]",
            "type": "string",
            "metadata": {
                "description": "Location for the Application Insights and Log Analytics resources."
            }
        },
        "applicationInsightsName": {
            "type": "string",
            "metadata": {
                "description": "Name of the Application Insights resource."
            }
        },
        "logAnalyticsWorkspaceName": {
            "type": "string",
            "metadata": {
                "description": "Name of the Log Analytics workspace."
            }
        },
        "logAnalyticsRetentionDays": {
            "defaultValue": 90,
            "minValue": 30,
            "maxValue": 730,
            "type": "int",
            "metadata": {
                "description": "Retention period for Log Analytics workspace (in days)."
            }
        },
        "resourceTags": {
            "defaultValue": {},
            "type": "object",
            "metadata": {
                "description": "Tags to assign to the resources."
            }
        }
    },
    "variables": {
        "logAnalyticsId": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('logAnalyticsWorkspaceName'))]",
        "applicationInsightsId": "[resourceId('Microsoft.Insights/components', parameters('applicationInsightsName'))]"
    },
    "resources": [
        {
            "type": "Microsoft.OperationalInsights/workspaces",
            "apiVersion": "2022-10-01",
            "name": "[parameters('logAnalyticsWorkspaceName')]",
            "location": "[parameters('location')]",
            "tags": "[parameters('resourceTags')]",
            "properties": {
                "sku": {
                    "name": "PerGB2018"
                },
                "retentionInDays": "[parameters('logAnalyticsRetentionDays')]",
                "features": {
                    "enableLogAccessUsingOnlyResourcePermissions": true
                },
                "workspaceCapping": {
                    "dailyQuotaGb": -1
                },
                "publicNetworkAccessForIngestion": "Enabled",
                "publicNetworkAccessForQuery": "Enabled"
            }
        },
        {
            "type": "Microsoft.Insights/components",
            "apiVersion": "2020-02-02",
            "name": "[parameters('applicationInsightsName')]",
            "location": "[parameters('location')]",
            "tags": "[parameters('resourceTags')]",
            "kind": "web",
            "dependsOn": [
                "[variables('logAnalyticsId')]"
            ],
            "properties": {
                "Application_Type": "web",
                "RetentionInDays": "[parameters('logAnalyticsRetentionDays')]",
                "WorkspaceResourceId": "[variables('logAnalyticsId')]",
                "IngestionMode": "LogAnalytics",
                "publicNetworkAccessForIngestion": "Enabled",
                "publicNetworkAccessForQuery": "Enabled",
                "SamplingPercentage": 100
            }
        }
    ],
    "outputs": {
        "logAnalyticsWorkspaceId": {
            "type": "string",
            "value": "[variables('logAnalyticsId')]"
        },
        "applicationInsightsId": {
            "type": "string",
            "value": "[variables('applicationInsightsId')]"
        },
        "applicationInsightsInstrumentationKey": {
            "type": "string",
            "value": "[reference(variables('applicationInsightsId'), '2020-02-02').InstrumentationKey]"
        },
        "applicationInsightsConnectionString": {
            "type": "string",
            "value": "[reference(variables('applicationInsightsId'), '2020-02-02').ConnectionString]"
        }
    }
}
