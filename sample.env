# CodeWiki Local Development Environment Variables
# Copy this file to .env and fill in your values
#
# To get your Azure OpenAI API key:
#   1. Go to Azure Portal -> Azure OpenAI -> your resource (aoai-orcas-je)
#   2. Keys and Endpoint -> Copy Key 1 or Key 2

AZURE_OPENAI_API_KEY=your-api-key-here
